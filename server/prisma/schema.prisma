generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Roles
enum Role {
  MEMBER
  STUDENT_MEMBER
  EDITOR
  EVENT_MANAGER
  ADMIN
  SUPER_ADMIN
}

// Publish Status for CMS & Events
enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Event Types
enum EventType {
  CONFERENCE
  WORKSHOP
  WEBINAR
}

// Course Types
enum CourseType {
  SELF_PACED
  WEBINAR
  EXTENSIVE_ONLINE
  E_LECTURE
  INTERACTIVE_SHORT
  PARTNER_COURSE
  VIDEO
}

// Membership Lifecycles
enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

// 1. Users & Auth
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens      RefreshToken[]
  memberships        Membership[]
  eventRegistrations EventRegistration[]
  courseEnrollments  CourseEnrollment[]
  articles           Article[]
  mediaAssets        MediaAsset[]
  communityMembers   CommunityMember[]
  formSubmissions    FormSubmission[]
  auditLogs          AuditLog[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// 2. Memberships
model MembershipPlan {
  id             String   @id @default(uuid())
  name           String
  description    String?
  price          Decimal  @db.Decimal(10, 2)
  durationMonths Int      @default(12)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships Membership[]
}

model Membership {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      MembershipPlan   @relation(fields: [planId], references: [id])
  status    MembershipStatus @default(PENDING)
  startDate DateTime         @default(now())
  endDate   DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  payments Payment[]
}

// 3. Transactions & Payments
model Payment {
  id                  String             @id @default(uuid())
  membershipId        String?
  membership          Membership?        @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  eventRegistrationId String?
  eventRegistration   EventRegistration? @relation(fields: [eventRegistrationId], references: [id], onDelete: SetNull)
  courseEnrollmentId  String?
  courseEnrollment    CourseEnrollment?  @relation(fields: [courseEnrollmentId], references: [id], onDelete: SetNull)
  amount              Decimal            @db.Decimal(10, 2)
  currency            String             @default("EUR")
  status              String // PENDING, COMPLETED, FAILED
  provider            String? // Stripe, PayPal, etc.
  providerPaymentId   String?            @unique
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

// 4. Events
model Event {
  id                   String        @id @default(uuid())
  slug                 String        @unique
  title                String
  description          String        @db.Text
  eventType            EventType
  status               PublishStatus @default(DRAFT)
  startDate            DateTime
  endDate              DateTime
  location             String? // Null for online events
  online               Boolean       @default(false)
  registrationDeadline DateTime?
  earlyBirdDeadline    DateTime?
  abstractDeadline     DateTime?
  priceMember          Decimal       @default(0.00) @db.Decimal(10, 2)
  priceNonMember       Decimal       @default(0.00) @db.Decimal(10, 2)
  organizer            String?
  imageUrl             String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  registrations EventRegistration[]
  categories    EventCategory[]     @relation("EventToEventCategory")
}

model EventCategory {
  id     String  @id @default(uuid())
  name   String  @unique
  slug   String  @unique
  events Event[] @relation("EventToEventCategory")
}

model EventRegistration {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("REGISTERED") // REGISTERED, CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

// 5. Education & Courses
model Course {
  id             String        @id @default(uuid())
  slug           String        @unique
  title          String
  description    String        @db.Text
  courseType     CourseType
  status         PublishStatus @default(DRAFT)
  startDate      DateTime? // Null for self-paced courses
  endDate        DateTime?
  instructor     String?
  priceMember    Decimal       @default(0.00) @db.Decimal(10, 2)
  priceNonMember Decimal       @default(0.00) @db.Decimal(10, 2)
  imageUrl       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  enrollments CourseEnrollment[]
  categories  CourseCategory[]   @relation("CourseToCourseCategory")
}

model CourseCategory {
  id      String   @id @default(uuid())
  name    String   @unique
  slug    String   @unique
  courses Course[] @relation("CourseToCourseCategory")
}

model CourseEnrollment {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("ENROLLED") // ENROLLED, COMPLETED, CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

// 6. News & CMS
model Article {
  id              String        @id @default(uuid())
  slug            String        @unique
  title           String
  excerpt         String?       @db.Text
  body            String        @db.Text
  featuredImage   String?
  status          PublishStatus @default(DRAFT)
  publishedAt     DateTime?
  authorId        String
  author          User          @relation(fields: [authorId], references: [id])
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  categories ArticleCategory[] @relation("ArticleToArticleCategory")
  tags       Tag[]             @relation("ArticleToTag")
}

model ArticleCategory {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  articles Article[] @relation("ArticleToArticleCategory")
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  articles Article[] @relation("ArticleToTag")
}

model Page {
  id              String        @id @default(uuid())
  slug            String        @unique
  title           String
  body            String        @db.Text
  status          PublishStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model MediaAsset {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  path         String
  uploaderId   String
  uploader     User     @relation(fields: [uploaderId], references: [id])
  createdAt    DateTime @default(now())
}

// 7. Communities
model Community {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String   @db.Text
  type        String // "SIG" or "CHAPTER"
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members CommunityMember[]
}

model CommunityMember {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER") // MEMBER, LEADER, CO_CHAIR
  joinedAt    DateTime  @default(now())

  @@unique([communityId, userId])
}

// 8. Forms & Submissions
model FormDefinition {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "membership-join", "student-chapter-application"
  title       String
  description String?  @db.Text
  fields      Json // JSON schema describing fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions FormSubmission[]
}

model FormSubmission {
  id               String         @id @default(uuid())
  formDefinitionId String
  formDefinition   FormDefinition @relation(fields: [formDefinitionId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  email            String? // For guest submissions
  data             Json // Submitted fields data
  status           String         @default("PENDING") // PENDING, REVIEWED, APPROVED, REJECTED
  createdAt        DateTime       @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  type      String   @default("GENERAL") // GENERAL, MEDIA, SUPPORT
  status    String   @default("UNREAD") // UNREAD, READ, REPLIED
  createdAt DateTime @default(now())
}

// 9. Administration & Settings
model SiteSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g., CREATE_EVENT, UPDATE_USER
  entityType String // e.g., Event, User
  entityId   String?
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())
}
